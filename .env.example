# Copy to .env and fill in. The pipeline and Streamlit app both read this file.

# Postgres connection (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chikungunya

# Pipeline paths (relative to repo root unless absolute).
INCOMING_DIR=data/incoming
REJECTS_DIR=data/rejects
ARCHIVE_DIR=data/archive

# Path to the Excel column-mapping config.
COLUMN_MAPPING_PATH=config/column_mapping.yaml
EXPECTATIONS_PATH=config/expectations.yaml

# Date parsing: prefer day-first (DD/MM/YYYY) interpretation for ambiguous dates.
DATE_DAYFIRST=true

# Load behaviour: append | replace
LOAD_MODE=append
